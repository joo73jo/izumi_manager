import 'package:flutter/material.dart';

import '../../../../core/database/app_database.dart';
import '../../data/quarterly_report_repository.dart';

class QuarterlyReportDialog extends StatefulWidget {
  const QuarterlyReportDialog({super.key, required this.database});

  final AppDatabase database;

  @override
  State<QuarterlyReportDialog> createState() => _QuarterlyReportDialogState();
}

class _QuarterlyReportDialogState extends State<QuarterlyReportDialog> {
  late int year;
  late int quarter;
  late Future<QuarterlyFinancialReport> report;

  @override
  void initState() {
    super.initState();

    final now = DateTime.now();
    year = now.year;
    quarter = ((now.month - 1) ~/ 3) + 1;
    reload();
  }

  void reload() {
    report = QuarterlyReportRepository(widget.database)
        .getReport(year: year, quarter: quarter);
  }

  String money(int cents) {
    final sign = cents < 0 ? '-' : '';
    final absolute = cents.abs();
    final whole = absolute ~/ 100;
    final decimals = (absolute % 100).toString().padLeft(2, '0');
    return '$sign\$$whole.$decimals';
  }

  Widget amountRow(String label, int cents, {bool prominent = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 7),
      child: Row(
        children: [
          Expanded(
            child: Text(
              label,
              style: TextStyle(
                fontWeight: prominent ? FontWeight.bold : FontWeight.normal,
              ),
            ),
          ),
          Text(
            money(cents),
            style: TextStyle(
              fontWeight: prominent ? FontWeight.bold : FontWeight.w500,
              color: prominent ? const Color(0xFF284426) : null,
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final currentYear = DateTime.now().year;

    return AlertDialog(
      title: const Text('Reporte financiero trimestral'),
      content: SizedBox(
        width: 570,
        height: 550,
        child: Column(
          children: [
            Row(
              children: [
                Expanded(
                  child: DropdownButtonFormField<int>(
                    key: ValueKey('year-$year'),
                    initialValue: year,
                    decoration: const InputDecoration(
                      labelText: 'A\u00f1o',
                      border: OutlineInputBorder(),
                    ),
                    items: [
                      for (var value = 2025; value <= currentYear + 1; value++)
                        DropdownMenuItem(value: value, child: Text('$value')),
                    ],
                    onChanged: (value) {
                      if (value == null) return;
                      setState(() {
                        year = value;
                        reload();
                      });
                    },
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: DropdownButtonFormField<int>(
                    key: ValueKey('quarter-$quarter'),
                    initialValue: quarter,
                    decoration: const InputDecoration(
                      labelText: 'Trimestre',
                      border: OutlineInputBorder(),
                    ),
                    items: const [
                      DropdownMenuItem(value: 1, child: Text('Ene - Mar')),
                      DropdownMenuItem(value: 2, child: Text('Abr - Jun')),
                      DropdownMenuItem(value: 3, child: Text('Jul - Sep')),
                      DropdownMenuItem(value: 4, child: Text('Oct - Dic')),
                    ],
                    onChanged: (value) {
                      if (value == null) return;
                      setState(() {
                        quarter = value;
                        reload();
                      });
                    },
                  ),
                ),
              ],
            ),
            const SizedBox(height: 18),
            Expanded(
              child: FutureBuilder<QuarterlyFinancialReport>(
                future: report,
                builder: (context, snapshot) {
                  if (snapshot.hasError) {
                    return SelectableText(
                      'No se pudo generar el reporte:\n'
                      '${snapshot.error}',
                    );
                  }

                  if (!snapshot.hasData) {
                    return const Center(child: CircularProgressIndicator());
                  }

                  final data = snapshot.data!;

                  return ListView(
                    children: [
                      Text(
                        'Resultados del trimestre',
                        style: Theme.of(context).textTheme.titleMedium,
                      ),
                      const SizedBox(height: 8),
                      amountRow('Ventas', data.salesCents),
                      amountRow(
                        'Costo de materiales vendidos',
                        -data.materialCostsCents,
                      ),
                      amountRow(
                        'Gastos operativos',
                        -data.operatingExpensesCents,
                      ),
                      amountRow('Otros ingresos', data.otherIncomeCents),
                      amountRow('Otros gastos', -data.otherExpensesCents),
                      const Divider(),
                      amountRow(
                        'Resultado neto contable',
                        data.netResultCents,
                        prominent: true,
                      ),
                      const SizedBox(height: 18),
                      Text(
                        'Propuesta de distribuci\u00f3n',
                        style: Theme.of(context).textTheme.titleMedium,
                      ),
                      const SizedBox(height: 8),
                      amountRow('Fondo retenido (50%)', data.reinvestmentCents),
                      amountRow(
                        'Joel (65% de lo distribuible)',
                        data.joelCents,
                      ),
                      amountRow(
                        'Paul (35% de lo distribuible)',
                        data.paulCents,
                      ),
                      const Divider(),
                      amountRow(
                        'Total propuesto',
                        data.reinvestmentCents +
                            data.joelCents +
                            data.paulCents,
                        prominent: true,
                      ),
                      const SizedBox(height: 14),
                      if (data.hasValuationWarnings)
                        Text(
                          'Advertencia: ${data.unvaluedSales} '
                          'venta(s) de macetas sin costo de '
                          'venta contabilizado.',
                          style: const TextStyle(
                            color: Colors.deepOrange,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      const SizedBox(height: 12),
                      const Text(
                        'Reporte provisional basado en los '
                        'asientos registrados. El reparto no '
                        'representa dinero disponible para pagar. '
                        'Antes de aprobarlo deben revisarse '
                        'los costos pendientes, impuestos, '
                        'obligaciones, ajustes y saldo bancario.',
                        style: TextStyle(fontSize: 12, color: Colors.black54),
                      ),
                    ],
                  );
                },
              ),
            ),
          ],
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text('Cerrar'),
        ),
      ],
    );
  }
}
